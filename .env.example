# Conexão PostgreSQL usada pelo Prisma. Não usar chaves da API Supabase nesta URL.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/championsbarber?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/championsbarber?schema=public"
PORT=3000
NODE_ENV=development
# Origens exatas permitidas para o frontend; separar por vírgula. Em produção, usar HTTPS.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcionais para o comando npm run admin:criar. A senha é solicitada no terminal.
ADMIN_NOME=
ADMIN_TELEFONE=
