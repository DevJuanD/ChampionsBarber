# Modelo para copiar os valores ao .env quando o banco remoto estiver pronto.
# Copiar host, porta e usuário da opção Connect no projeto Supabase.
# A senha deve ser codificada para URL. Estas são credenciais fictícias.
# CA pública em prisma/certs/supabase-ca.crt; caminho relativo ao schema Prisma.

# Express em servidor persistente: Session pooler (5432), com SSL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&sslaccept=strict&sslcert=certs/supabase-ca.crt&connection_limit=5&connect_timeout=10"

# Ferramentas Prisma: Session pooler ou conexão direta, sem modo transaction.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&sslaccept=strict&sslcert=certs/supabase-ca.crt&connect_timeout=10"

# Alternativa para DATABASE_URL com Transaction pooler (6543):
# postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?schema=public&sslmode=require&sslaccept=strict&sslcert=certs/supabase-ca.crt&pgbouncer=true&connection_limit=5&connect_timeout=10

PORT=3000
NODE_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_NOME=
ADMIN_TELEFONE=
